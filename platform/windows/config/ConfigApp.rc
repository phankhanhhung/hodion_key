// Chỉ mô tả bố cục; toàn bộ nhãn tiếng Việt được gán lúc chạy bằng
// SetDlgItemTextW (tránh lệ thuộc code page của rc.exe / windres).
#include <windows.h>
#include "resource.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

// Chỉ nhúng manifest ở đây khi trình liên kết không tự sinh manifest (MinGW).
// MSVC luôn tự sinh một cái, nhúng thêm từ .rc sẽ trùng resource và hỏng
// link (CVT1100). Ở MSVC, file manifest được đưa thẳng cho linker qua
// CMake để nó gộp vào manifest của chính nó.
#ifdef HODION_RC_MANIFEST
1 RT_MANIFEST "HodionKeyConfig.manifest"
#endif

IDD_CONFIG DIALOGEX 0, 0, 296, 297
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HodionKey"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Input method", IDC_GRP_METHOD, 7, 7, 138, 46
    CONTROL         "Telex", IDC_METHOD_TELEX, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 21, 120, 12
    CONTROL         "VNI", IDC_METHOD_VNI, "Button",
                    BS_AUTORADIOBUTTON, 14, 35, 120, 12

    GROUPBOX        "Tone placement", IDC_GRP_TONE, 151, 7, 138, 46
    CONTROL         "Traditional", IDC_TONE_TRADITIONAL, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 158, 21, 124, 12
    CONTROL         "Modern", IDC_TONE_MODERN, "Button",
                    BS_AUTORADIOBUTTON, 158, 35, 124, 12

    GROUPBOX        "Options", IDC_GRP_OPTIONS, 7, 59, 282, 92
    CONTROL         "Free marking", IDC_OPT_FREEMARKING, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 14, 73, 268, 12
    CONTROL         "Spell check", IDC_OPT_SPELLCHECK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 88, 268, 12
    CONTROL         "Restore non-Vietnamese words", IDC_OPT_RESTORE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 103, 268, 12
    CONTROL         "W shorthand", IDC_OPT_WSHORTHAND, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 118, 268, 12
    CONTROL         "Telex brackets", IDC_OPT_BRACKETS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 133, 268, 12

    GROUPBOX        "Mixed Vietnamese / English", IDC_GRP_MIXED, 7, 157, 282, 47
    CONTROL         "Skip URL / e-mail / password fields", IDC_OPT_INPUTSCOPE,
                    "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,
                    14, 171, 268, 12
    LTEXT           "", IDC_LBL_MIXEDHINT, 14, 187, 268, 10

    GROUPBOX        "Vietnamese on/off", IDC_GRP_TOGGLE, 7, 210, 282, 62
    LTEXT           "Toggle key:", IDC_LBL_TOGGLE, 14, 226, 80, 10
    COMBOBOX        IDC_COMBO_TOGGLE, 98, 224, 120, 120,
                    CBS_DROPDOWNLIST | WS_GROUP | WS_TABSTOP | WS_VSCROLL
    CONTROL         "Vietnamese input is on", IDC_CHK_VIETNAMESE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 243, 268, 12
    LTEXT           "", IDC_LBL_HINT, 14, 257, 268, 10

    PUSHBUTTON      "Defaults", IDC_DEFAULTS, 7, 274, 80, 16, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 155, 274, 64, 16, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 225, 274, 64, 16, WS_TABSTOP
END
