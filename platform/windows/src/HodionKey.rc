// Chỉ có VERSIONINFO: DLL không có giao diện nào. Windows hiện khối này ở
// tab Details của file, và bộ cài ghi đúng con số này vào mục gỡ cài đặt.
#include <windows.h>
#include "hodion_version.h"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    HODION_VERSION_MAJOR, HODION_VERSION_MINOR, HODION_VERSION_PATCH, 0
  PRODUCTVERSION HODION_VERSION_MAJOR, HODION_VERSION_MINOR, HODION_VERSION_PATCH, 0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_DLL
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "000004b0"   // trung lập ngôn ngữ, trang mã Unicode
    BEGIN
      VALUE "CompanyName",      "HodionKey"
      VALUE "FileDescription",  "HodionKey - bo go tieng Viet (TSF text service)"
      VALUE "FileVersion",      HODION_VERSION_STR
      VALUE "InternalName",     "HodionKey"
      VALUE "OriginalFilename", "HodionKey.dll"
      VALUE "ProductName",      "HodionKey"
      VALUE "ProductVersion",   HODION_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0000, 1200
  END
END
